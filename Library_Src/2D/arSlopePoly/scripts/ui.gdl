ui_dialog "ARHIM Naklonski poligon"UI_CURRENT_PAGE gs_ui_current_pagexLeft = 20yTop = 5yLabel = 14yRow = 40iPageIDRoot			= -1iPageIDNodes		=  1iPageID2DRepr		=  2iPageIDText			=  3! ==============================================================================! UI_PAGES! ==============================================================================	UI_PAGE iPageIDNodes, iPageIDRoot, 'Vozlišča in naklon'		gosub "nodesPage"	UI_PAGE iPageID2DRepr, iPageIDRoot, '2D prikaz'		gosub "2DRepr"	UI_PAGE iPageIDText, iPageIDRoot, 'Napis in kote'		gosub "textPage"END! ==============================================================================! SUBROUTINES! ==============================================================================! ------------------------------------------------------------------------------! section header with a separator line above; sY = y offset, sTitle = caption"sectionTitle":	ui_separator xLeft - 10, yTop + sY, xLeft + 440, yTop + sY	ui_style 0, 1	ui_outfield sTitle, xLeft, yTop + sY + 4, 300, 14	ui_style 0, 0return! ------------------------------------------------------------------------------"nodesPage":	ui_outfield "Vozlišče:", xLeft, 							yTop, 60, 14	ui_infield "ui_node_index", xLeft, 							yTop + yLabel, 60, 24	ui_outfield "od " + STR(n, 1, 0), xLeft + 66, 				yTop + yLabel + 5, 50, 14	IF n < 20 THEN		ui_button UI_FUNCTION, "Dodaj vozlišče", xLeft + 130, 	yTop + yLabel, 130, 24, 1	ENDIF	IF n > 2 THEN		ui_button UI_FUNCTION, "Izbriši vozlišče", xLeft + 270,	yTop + yLabel, 130, 24, 2	ENDIF	sY = 52: sTitle = "Položaj vozlišča": gosub "sectionTitle"	ui_outfield "X:", xLeft, 									yTop + 74, 120, 14	ui_infield "ui_node_x", xLeft, 								yTop + 74 + yLabel, 120, 24	ui_outfield "Y:", xLeft + 130, 								yTop + 74, 120, 14	ui_infield "ui_node_y", xLeft + 130, 						yTop + 74 + yLabel, 120, 24	! one segment less than nodes: segment i connects node i and node i+1	sY = 140: sTitle = "Naklon odseka": gosub "sectionTitle"	ui_outfield "Odsek:", xLeft, 								yTop + 162, 60, 14	ui_infield "ui_segment_index", xLeft, 						yTop + 162 + yLabel, 60, 24	ui_outfield "od " + STR(n - 1, 1, 0), xLeft + 66, 			yTop + 162 + yLabel + 5, 50, 14	ui_outfield "Naklon [%]:", xLeft + 130, 					yTop + 162, 120, 14	ui_infield "ui_segment_slope", xLeft + 130, 				yTop + 162 + yLabel, 120, 24	ui_outfield "Višinska razlika vseh odsekov:", xLeft + 260, 	yTop + 162, 200, 14	ui_infield "totalElevation", xLeft + 260, 					yTop + 162 + yLabel, 120, 24	ui_outfield "Odsek povezuje vozlišče " + STR(ui_segment_index, 1, 0) + " in vozlišče " + STR(ui_segment_index + 1, 1, 0) + ".", xLeft, yTop + 162 + yLabel + 32, 400, 14return! ------------------------------------------------------------------------------"2DRepr":	aRow = 1	xOffset = 0	ui_outfield "Barva obrisa:", xLeft + xOffset, 				yTop + (aRow - 1) * yRow , 100, 14	ui_infield "penOutline", xLeft + xOffset, 					yTop + (aRow - 1) * yRow + yLabel, 40, 24	xOffset = xOffset + 110	ui_outfield "Barva šrafure:", xLeft + xOffset, 				yTop + (aRow - 1) * yRow , 100, 14	ui_infield "penFill", xLeft + xOffset, 						yTop + (aRow - 1) * yRow + yLabel, 40, 24	xOffset = xOffset + 110	ui_outfield "Barva ozadja:", xLeft + xOffset, 				yTop + (aRow - 1) * yRow , 100, 14	ui_infield "penBg", xLeft + xOffset, 						yTop + (aRow - 1) * yRow + yLabel, 40, 24	aRow = aRow + 1.2	xOffset = 0	sY = (aRow - 1) * yRow - 8: sTitle = "Prikaz naklona": gosub "sectionTitle"	aRow = aRow + 0.4	ui_outfield "Merilo naklona:", xLeft + xOffset, 			yTop + (aRow - 1) * yRow , 110, 14	ui_infield "scale", xLeft + xOffset, 						yTop + (aRow - 1) * yRow + yLabel, 100, 24	aRow = aRow + 1	ui_infield "drawSlopeArrow", xLeft + xOffset, 				yTop + (aRow - 1) * yRow + 2, 20, 20	ui_outfield "Prikaži puščico naklona", xLeft + xOffset + 24, yTop + (aRow - 1) * yRow + 5, 170, 14	xOffset = xOffset + 220	ui_outfield "Merilo puščice:", xLeft + xOffset, 			yTop + (aRow - 1) * yRow - 14 , 110, 14	ui_infield "arrowScale", xLeft + xOffset, 					yTop + (aRow - 1) * yRow , 100, 24return! ------------------------------------------------------------------------------"textPage":	aRow = 1	xOffset = 0	ui_infield "showElevations", xLeft + xOffset, 				yTop + (aRow - 1) * yRow + 2, 20, 20	ui_style 0, 1	ui_outfield "Prikaži kote", xLeft + xOffset + 24, 			yTop + (aRow - 1) * yRow + 5, 150, 14	ui_style 0, 0	xOffset = xOffset + 200	ui_infield "startFromTop", xLeft + xOffset, 				yTop + (aRow - 1) * yRow + 2, 20, 20	ui_outfield "Kote štej od vrha", xLeft + xOffset + 24, 		yTop + (aRow - 1) * yRow + 5, 150, 14	aRow = aRow + 1.2	xOffset = 0	ui_outfield "Pisava:", xLeft + xOffset, 					yTop + (aRow - 1) * yRow , 100, 14	ui_infield "fontFace", xLeft + xOffset, 					yTop + (aRow - 1) * yRow + yLabel, 200, 24	xOffset = xOffset + 210	ui_outfield "Velikost:", xLeft + xOffset, 					yTop + (aRow - 1) * yRow , 80, 14	ui_infield "fontSize", xLeft + xOffset, 					yTop + (aRow - 1) * yRow + yLabel, 80, 24	xOffset = xOffset + 90	ui_outfield "Barva:", xLeft + xOffset, 						yTop + (aRow - 1) * yRow , 50, 14	ui_infield "penText", xLeft + xOffset, 						yTop + (aRow - 1) * yRow + yLabel, 40, 24return