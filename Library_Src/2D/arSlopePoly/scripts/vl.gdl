HIDEPARAMETER ALLparameters xyz = xyz, n = n, xyz_ea = xyz_e, degrees = degreesdim fontNames[]res = request("FONTNAMES_LIST", "", fontNames)values "fontFace", fontNames, CUSTOMMAX_POINTS = 20nix = 0.00001!----------------------------------------! node selection and editing (ui)!----------------------------------------uiNode = ui_node_indexif uiNode < 1 then uiNode = 1if uiNode > n then uiNode = nif GLOB_UI_BUTTON_ID = 1 then gosub "insertNode"if GLOB_UI_BUTTON_ID = 2 then gosub "deleteNode"uiSeg = ui_segment_indexif uiSeg < 1 then uiSeg = 1if uiSeg > n - 1 then uiSeg = n - 1if GLOB_MODPAR_NAME = "ui_node_x" then xyz[uiNode][1] = ui_node_xif GLOB_MODPAR_NAME = "ui_node_y" then xyz[uiNode][2] = ui_node_yif GLOB_MODPAR_NAME = "ui_segment_slope" then slopes[uiSeg] = ui_segment_slopeif uiNode > n then uiNode = nif uiNode < 1 then uiNode = 1if uiSeg > n - 1 then uiSeg = n - 1if uiSeg < 1 then uiSeg = 1dim uiNodeRange[]for i = 1 to n	uiNodeRange[i] = inext ivalues "ui_node_index" uiNodeRange! segment i connects node i and node i+1, so there is one segment less than nodesdim uiSegmentRange[]for i = 1 to n - 1	uiSegmentRange[i] = inext ivalues "ui_segment_index" uiSegmentRangeparameters ui_node_index = uiNodeparameters ui_node_x = xyz[uiNode][1]parameters ui_node_y = xyz[uiNode][2]parameters ui_segment_index = uiSegparameters ui_segment_slope = slopes[uiSeg]!----------------------------------------! total elevation of all segments!----------------------------------------totalElevation = 0for i = 2 to n	segLength = sqr((xyz[i][1] - xyz[i-1][1])^2 + (xyz[i][2] - xyz[i-1][2])^2)	totalElevation = totalElevation + slopes[i-1] * segLength / 100next iparameters xyz = xyz, n = n, slopes = slopesparameters totalElevation = totalElevationlock "totalElevation"if GLOB_MODPAR_NAME = "degrees" then	for i = 1 to n-1		!slopes[i] = degrees[i] / 2	next i	!parameters slopes = slopesendifexit!----------------------------------------! insert node (button 1)! a node is added in the middle of the segment after the selected node;! on the last node the polygon is extended by one unit along the last segment!----------------------------------------"insertNode":	if n < MAX_POINTS then		if uiNode < n then			insPos = uiNode + 1			newX = (xyz[uiNode][1] + xyz[uiNode+1][1]) / 2			newY = (xyz[uiNode][2] + xyz[uiNode+1][2]) / 2			newZ = (xyz[uiNode][3] + xyz[uiNode+1][3]) / 2			for i = n to insPos step -1				xyz[i+1] = xyz[i]				slopes[i+1] = slopes[i]			next i			slopes[insPos] = slopes[insPos-1]		else			insPos = n + 1			dX = xyz[n][1] - xyz[n-1][1]			dY = xyz[n][2] - xyz[n-1][2]			segLength = sqr(dX^2 + dY^2)			if segLength < nix then				dX = 1: dY = 0: segLength = 1			endif			newX = xyz[n][1] + dX / segLength			newY = xyz[n][2] + dY / segLength			newZ = xyz[n][3]			slopes[n] = slopes[n-1]		endif		xyz[insPos][1] = newX		xyz[insPos][2] = newY		xyz[insPos][3] = newZ		n = n + 1		uiNode = insPos	endifreturn!----------------------------------------! delete node (button 2)! the slope of the segment before the node is kept, the one after it is dropped!----------------------------------------"deleteNode":	if n > 2 then		for i = uiNode to n - 1			xyz[i] = xyz[i+1]			slopes[i] = slopes[i+1]		next i		n = n - 1		for i = n + 1 to MAX_POINTS			xyz[i] = xyz[n]		next i		if uiNode > n then uiNode = n	endifreturn