unId = 1
openingWidth = A
thkPlasterOuter = thk_plaster * plaster_outer		! plaster plate on the outer end of insulation

wallhole2 4, 0, 0, -1,
	0, 0, 0,
	-openingWidth/2 + thk_insulation, 	0, 			1,
	openingWidth/2 - thk_insulation, 	0, 			1,
	openingWidth/2 - thk_insulation, 	-WALL_THICKNESS+WIDO_SILL, 	1,
	-openingWidth/2 + thk_insulation, 	-WALL_THICKNESS+WIDO_SILL, 	1

!rect2 -openingWidth/2, 0, openingWidth/2, boxWidth

dim fillProperties[3]
n = REQUEST{2} ("Building_Material_info", mat_insulation, "gs_bmat_cutFill_properties", fillProperties)
set fill fillProperties[1]

dim fillPlasterProperties[3]
n = REQUEST{2} ("Building_Material_info", mat_plaster, "gs_bmat_cutFill_properties", fillPlasterProperties)


thk = WALL_THICKNESS - WIDO_SILL - thk_plaster
if leftCorner then
	hotspot2 0, 0, unId, leftCornerAngle, 4: unId = unId + 1
	hotspot2 -openingWidth/2 + thk*cos(leftCornerAngle), -thk * sin(leftCornerAngle), unId, leftCornerAngle, 5: unId = unId + 1
	hotspot2 -openingWidth/2, 0, unId, leftCornerAngle, 6+512: unId = unId + 1
endif

if rightCorner then	
	hotspot2 0, 0, unId, rightCornerAngle, 4: unId = unId + 1
	hotspot2 openingWidth/2 + thk*cos(rightCornerAngle), -thk * sin(rightCornerAngle), unId, rightCornerAngle, 5: unId = unId + 1
	hotspot2 openingWidth/2, 0, unId, rightCornerAngle, 6+512: unId = unId + 1
endif

if GLOB_STRUCTURE_DISPLAY = 0 OR GLOB_STRUCTURE_DISPLAY = 2 then
	if sides[_LEFT] then
		poly2_b 4, 1+2+4, 
			fillProperties[2], fillProperties[3],
			-openingWidth/2, 					-thkPlasterOuter, 				1,
			-openingWidth/2 + thk_insulation, 	-thkPlasterOuter, 				1,
			-openingWidth/2 + thk_insulation, 	-WALL_THICKNESS + WIDO_SILL + thk_plaster, 1,
			-openingWidth/2, 					-WALL_THICKNESS + WIDO_SILL + thk_plaster, 1
	endif
	
	
	if sides[_RIGHT] then
		poly2_b 4, 1+2+4, 
			fillProperties[2], fillProperties[3],
			openingWidth/2, 					-thkPlasterOuter, 				1,
			openingWidth/2 - thk_insulation, 	-thkPlasterOuter, 				1,
			openingWidth/2 - thk_insulation, 	-WALL_THICKNESS + WIDO_SILL + thk_plaster, 1,
			openingWidth/2, 					-WALL_THICKNESS + WIDO_SILL + thk_plaster, 1
	endif
endif

if GLOB_STRUCTURE_DISPLAY = 0 then
	! reveal plaster
	dim v[4]
	v = sides

	pen pen_plaster
	set fill fillPlasterProperties[1]

	!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
	! plaster on top of insulation

	!if plaster_sides[_RIGHT] then
		if not(plaster_outer) then
			hotspot2 openingWidth/2 - thk_insulation - thk_plaster_sill, 0, unId, offset_plaster, 1: unId = unId + 1
			hotspot2 openingWidth/2 - thk_insulation - thk_plaster_sill, -offset_plaster, unId, offset_plaster, 2: unId = unId + 1
			hotspot2 openingWidth/2 - thk_insulation - thk_plaster_sill, +1, unId, offset_plaster, 3: unId = unId + 1
		endif

		! z zunanjim ometom se omet na špaleti začne takoj za njim
		_offset = offset_plaster
		_legStatus = 1
		if plaster_outer then
			_offset = thk_plaster
			_legStatus = 0
		endif
		! to je primer, ko je izključen omet na špaleti
		if not(plaster_sides[_RIGHT]) then _offset = WALL_THICKNESS - WIDO_SILL

		poly2_b 7, 1+2+4, 
		fillPlasterProperties[2], fillPlasterProperties[3],
		openingWidth/2 - thk_insulation * v[_RIGHT], 												-_offset, 				_legStatus,
		openingWidth/2 - thk_insulation * v[_RIGHT] - thk_plaster_sill * plaster_sides[_RIGHT], 	-_offset, 				1,		
		openingWidth/2 - thk_insulation * v[_RIGHT] - thk_plaster_sill * plaster_sides[_RIGHT], 	-WALL_THICKNESS + WIDO_SILL, 1,
		openingWidth/2, 																			-WALL_THICKNESS + WIDO_SILL, 1,
		openingWidth/2, 																			-WALL_THICKNESS + WIDO_SILL, 0,
		openingWidth/2, 																			-WALL_THICKNESS + WIDO_SILL + thk_plaster, 1,
		openingWidth/2 - thk_insulation * v[_RIGHT], 												-WALL_THICKNESS + WIDO_SILL + thk_plaster, 1

		! outer plaster plate
		if plaster_outer then
			poly2_b 5, 1+2+4, 
			fillPlasterProperties[2], fillPlasterProperties[3],
			openingWidth/2, 																			0, 				1,
			openingWidth/2 - thk_insulation * v[_RIGHT] - thk_plaster_sill * plaster_sides[_RIGHT], 	0, 				1,
			openingWidth/2 - thk_insulation * v[_RIGHT] - thk_plaster_sill * plaster_sides[_RIGHT], 	-thk_plaster, 	0,
			openingWidth/2 - thk_insulation * v[_RIGHT], 												-thk_plaster, 	1,
			openingWidth/2, 																			-thk_plaster, 	0
		endif
	!endif

	!if plaster_sides[_LEFT] then
		if not(plaster_outer) then
			hotspot2 -openingWidth/2 + thk_insulation + thk_plaster_sill, 0, unId, offset_plaster, 1: unId = unId + 1
			hotspot2 -openingWidth/2 + thk_insulation + thk_plaster_sill, -offset_plaster, unId, offset_plaster, 2: unId = unId + 1
			hotspot2 -openingWidth/2 + thk_insulation + thk_plaster_sill, +1, unId, offset_plaster, 3: unId = unId + 1
		endif

		! z zunanjim ometom se omet na špaleti začne takoj za njim
		_offset = offset_plaster
		_legStatus = 1
		if plaster_outer then
			_offset = thk_plaster
			_legStatus = 0
		endif
		! to je primer, ko je izključen omet na špaleti
		if not(plaster_sides[_LEFT]) then _offset = WALL_THICKNESS - WIDO_SILL

		poly2_b 7, 1+2+4, 
		fillPlasterProperties[2], fillPlasterProperties[3],
		-openingWidth/2 + thk_insulation * v[_LEFT], 											-_offset, 				_legStatus,
		-openingWidth/2 + thk_insulation * v[_LEFT] + thk_plaster_sill * plaster_sides[_LEFT], 	-_offset, 				1,		
		-openingWidth/2 + thk_insulation * v[_LEFT] + thk_plaster_sill * plaster_sides[_LEFT], 	-WALL_THICKNESS + WIDO_SILL, 1,
		-openingWidth/2, 																		-WALL_THICKNESS + WIDO_SILL, 1,
		-openingWidth/2, 																		-WALL_THICKNESS + WIDO_SILL, 0,
		-openingWidth/2, 																		-WALL_THICKNESS + WIDO_SILL + thk_plaster, 1,
		-openingWidth/2 + thk_insulation * v[_LEFT], 											-WALL_THICKNESS + WIDO_SILL + thk_plaster, 1

		! outer plaster plate
		if plaster_outer then
			poly2_b 5, 1+2+4, 
			fillPlasterProperties[2], fillPlasterProperties[3],
			-openingWidth/2, 																		0, 				1,
			-openingWidth/2 + thk_insulation * v[_LEFT] + thk_plaster_sill * plaster_sides[_LEFT], 	0, 				1,
			-openingWidth/2 + thk_insulation * v[_LEFT] + thk_plaster_sill * plaster_sides[_LEFT], 	-thk_plaster, 	0,
			-openingWidth/2 + thk_insulation * v[_LEFT], 											-thk_plaster, 	1,
			-openingWidth/2, 																		-thk_plaster, 	0
		endif
	!endif
endif