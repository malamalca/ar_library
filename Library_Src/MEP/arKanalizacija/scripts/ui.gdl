! ------------------------------------------------------------------------------
"2DRepr":
	! --- tloris ---
	aRow = 1
	xOffset = 0
	ui_style 0, 1
	ui_outfield "Tloris", xLeft + xOffset, 					yTop + (aRow - 1) * yRow, 200, 14
	ui_style 0, 0

	aRow = aRow + 0.5
	xOffset = 0
	ui_outfield "Os cevi:", xLeft + xOffset, 				yTop + (aRow - 1) * yRow , 90, 14
	ui_infield "showAxis", xLeft + xOffset, 				yTop + (aRow - 1) * yRow + yLabel, 20, 22

	xOffset = xOffset + 90
	ui_outfield "Debelina cevi:", xLeft + xOffset, 			yTop + (aRow - 1) * yRow , 90, 14
	ui_infield "showPipeOffsetLines", xLeft + xOffset, 		yTop + (aRow - 1) * yRow + yLabel, 20, 22

	xOffset = xOffset + 90
	ui_outfield "Obod jaška:", xLeft + xOffset, 			yTop + (aRow - 1) * yRow , 90, 14
	ui_infield "showShaftSize", xLeft + xOffset, 			yTop + (aRow - 1) * yRow + yLabel, 20, 22

	xOffset = xOffset + 90
	ui_outfield "Zadnji jašek:", xLeft + xOffset, 			yTop + (aRow - 1) * yRow , 90, 14
	ui_infield "showLastShaft", xLeft + xOffset, 			yTop + (aRow - 1) * yRow + yLabel, 20, 22

	aRow = aRow + 1
	xOffset = 0
	ui_outfield "Napis cevi:", xLeft + xOffset, 			yTop + (aRow - 1) * yRow , 100, 14
	ui_infield "showPipeCaption", xLeft + xOffset, 			yTop + (aRow - 1) * yRow + yLabel, 80, 22

	xOffset = xOffset + 90
	ui_outfield "Napis jaška:", xLeft + xOffset, 			yTop + (aRow - 1) * yRow , 100, 14
	ui_infield "showShaftCaption", xLeft + xOffset, 		yTop + (aRow - 1) * yRow + yLabel, 80, 22

	! --- profil ---
	aRow = aRow + 1.2
	xOffset = 0
	ui_separator xLeft + xOffset - 10, 						yTop + (aRow - 1) * yRow - 5, 		xLeft + xOffset + 440, 		yTop + (aRow - 1) * yRow - 5
	ui_style 0, 1
	ui_outfield "Profil", xLeft + xOffset, 					yTop + (aRow - 1) * yRow, 200, 14
	ui_style 0, 0

	aRow = aRow + 0.5
	xOffset = 0
	ui_outfield "Širina:", xLeft + xOffset, 				yTop + (aRow - 1) * yRow , 100, 14
	ui_infield "profileWidth", xLeft + xOffset, 			yTop + (aRow - 1) * yRow + yLabel, 100, 22

	xOffset = xOffset + 110
	ui_outfield "Višina:", xLeft + xOffset, 				yTop + (aRow - 1) * yRow , 100, 14
	ui_infield "profileHeight", xLeft + xOffset, 			yTop + (aRow - 1) * yRow + yLabel, 100, 22

	xOffset = xOffset + 110
	ui_outfield "Položaj X:", xLeft + xOffset, 				yTop + (aRow - 1) * yRow , 100, 14
	ui_infield "profilePosX", xLeft + xOffset, 				yTop + (aRow - 1) * yRow + yLabel, 100, 22

	xOffset = xOffset + 110
	ui_outfield "Položaj Y:", xLeft + xOffset, 				yTop + (aRow - 1) * yRow , 100, 14
	ui_infield "profilePosY", xLeft + xOffset, 				yTop + (aRow - 1) * yRow + yLabel, 100, 22

	aRow = aRow + 1
	xOffset = 0
	ui_outfield "Dodatna globina izkopa:", xLeft + xOffset, yTop + (aRow - 1) * yRow , 150, 14
	ui_infield "shaftAdditionalDepth", xLeft + xOffset, 	yTop + (aRow - 1) * yRow + yLabel, 100, 22
return

! ------------------------------------------------------------------------------
"3DRepr":
	aRow = 1
	xOffset = 0
	ui_outfield "Prikaži 3D:", xLeft + xOffset, 			yTop + (aRow - 1) * yRow , 100, 14
	ui_infield "show3D", xLeft + xOffset, 					yTop + (aRow - 1) * yRow + yLabel, 20, 22

	xOffset = xOffset + 100
	ui_outfield "Meče senco:", xLeft + xOffset, 			yTop + (aRow - 1) * yRow , 100, 14
	ui_infield "cast_shadow", xLeft + xOffset, 				yTop + (aRow - 1) * yRow + yLabel, 20, 22

	aRow = aRow + 1
	xOffset = 0
	ui_outfield "Material jaška:", xLeft + xOffset, 		yTop + (aRow - 1) * yRow , 150, 14
	ui_infield "surface_mat", xLeft + xOffset, 				yTop + (aRow - 1) * yRow + yLabel, 200, 24

	aRow = aRow + 1
	ui_outfield "Material pokrova:", xLeft + xOffset, 		yTop + (aRow - 1) * yRow , 150, 14
	ui_infield "coverMat", xLeft + xOffset, 				yTop + (aRow - 1) * yRow + yLabel, 200, 24

	aRow = aRow + 1
	ui_outfield "Material cevi:", xLeft + xOffset, 			yTop + (aRow - 1) * yRow , 150, 14
	ui_infield "pipeMat", xLeft + xOffset, 					yTop + (aRow - 1) * yRow + yLabel, 200, 24
return