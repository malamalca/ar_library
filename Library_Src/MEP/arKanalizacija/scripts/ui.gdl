"profilePage":
	aRow = 1
	xOffset = 0
	ui_outfield "Črta cevi:", xLeft + xOffset, 			yTop + (aRow - 1) * yRow , 100, 14
	ui_infield "profilePipeLine", xLeft + xOffset, 			yTop + (aRow - 1) * yRow + yLabel, 100, 24

	xOffset = xOffset + 100
	ui_outfield "Barva:", xLeft + xOffset, 					yTop + (aRow - 1) * yRow, 50, 14
	ui_infield "profilePipePen", xLeft + xOffset, 			yTop + (aRow - 1) * yRow + yLabel, 35, 24

	xOffset = xOffset + 50
	ui_outfield "Črta terena:", xLeft + xOffset, 			yTop + (aRow - 1) * yRow , 100, 14
