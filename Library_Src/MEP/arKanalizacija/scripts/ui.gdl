	ui_infield "profileTextPen", xLeft + xOffset, 	yTop + (aRow - 1) * yRow + yLabel, 35, 24

	xOffset = xOffset + 50
	ui_outfield "Slog:", xLeft + xOffset + 350, 		yTop + (aRow - 1) * yRow, 100, 14
