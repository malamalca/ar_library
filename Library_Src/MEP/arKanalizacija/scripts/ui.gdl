	aRow = aRow + 1

	xOffset = 0
	ui_outfield "Pisava napisa jaška:", xLeft + xOffset, 			yTop + (aRow - 1) * yRow , 150, 14
	ui_infield "profileShaftCaptionTextFont", xLeft + xOffset, 	yTop + (aRow - 1) * yRow + yLabel, 200, 24

	xOffset = xOffset + 210
	ui_outfield "Velikost [mm]:", xLeft + xOffset, 			yTop + (aRow - 1) * yRow , 100, 14
	ui_infield "profileShaftCaptionTextSize", xLeft + xOffset, 	yTop + (aRow - 1) * yRow + yLabel, 80, 24

	xOffset = xOffset + 90
	ui_outfield "Barva:", xLeft + xOffset, 				yTop + (aRow - 1) * yRow, 100, 14
	ui_infield "profileShaftCaptionTextPen", xLeft + xOffset, 	yTop + (aRow - 1) * yRow + yLabel, 35, 24

	xOffset = xOffset + 50
	ui_outfield "Slog:", xLeft + xOffset + 350, 		yTop + (aRow - 1) * yRow, 100, 14
