ui_dialog "ARHIM Kanalizacija"
UI_CURRENT_PAGE gs_ui_current_page

xLeft = 20

yTop = 5
yLabel = 14
yRow = 40

iPageIDRoot 			= -1
iPageIDBasics			=  1
iPageShaft				=  2
iPageShaftData			=  8
iPagePipe				=  3
iPageProfile			=  4
iPageID2DRepr			=  5
iPageID3DRepr			=  6
iPageIDDescript 		=  7


! ==============================================================================
!UI_PAGES
! ==============================================================================

	UI_PAGE iPageIDBasics, iPageIDRoot, 'Osnovne nastavitve', 51
		gosub "basicsPage"

	UI_PAGE iPageShaft, iPageIDRoot, 'Jaški', 55
		gosub "shaftPage"

	UI_PAGE iPageShaftData, iPageIDRoot, 'Podatki jaška', 55
		gosub "shaftDataPage"

	UI_PAGE iPagePipe, iPageIDRoot, 'Cevi', 55
		gosub "pipePage"

	UI_PAGE iPageProfile, iPageIDRoot, 'Profil', 55
		gosub "profilePage"

	UI_PAGE iPageID2DRepr, iPageIDRoot, '2D Prikaz', 54
		gosub "2DRepr"

	UI_PAGE iPageID3DRepr, iPageIDRoot, '3D Prikaz', 54
		gosub "3DRepr"
END


! ==============================================================================
!SUBROUTINES
! ==============================================================================

! ------------------------------------------------------------------------------
"basicsPage":
	aRow = 1
	xOffset = 0
	ui_outfield "Predpona odseka:", xLeft + xOffset, 			yTop + (aRow - 1) * yRow , 100, 14
	ui_infield "prefix", xLeft + xOffset, 			yTop + (aRow - 1) * yRow + yLabel, 100, 24

	aRow = aRow + 1
	xOffset = 0
	ui_outfield "Dolžina odseka:", xLeft + xOffset, 			yTop + (aRow - 1) * yRow , 100, 14
	ui_infield "totalLength", xLeft + xOffset, 			yTop + (aRow - 1) * yRow + yLabel, 100, 24

	aRow = aRow + 1
	xOffset = 0
	ui_outfield "Nadmorska višina kote 0,00:", xLeft + xOffset, 	yTop + (aRow - 1) * yRow , 200, 14
	ui_infield "elevZeroAbs", xLeft + xOffset, 			yTop + (aRow - 1) * yRow + yLabel, 100, 24
return

! ------------------------------------------------------------------------------
"shaftPage":
	aRow = 1
	xOffset = 0
	ui_outfield "Črta pokrova:", xLeft + xOffset, 			yTop + (aRow - 1) * yRow , 100, 14
	ui_infield "lineShaftCover", xLeft + xOffset, 			yTop + (aRow - 1) * yRow + yLabel, 100, 24

	xOffset = xOffset + 100
	ui_outfield "Barva:", xLeft + xOffset, 					yTop + (aRow - 1) * yRow, 100, 14
	ui_infield "penShaftCover", xLeft + xOffset, 			yTop + (aRow - 1) * yRow + yLabel, 35, 24

	xOffset = xOffset + 50
	ui_outfield "Obod:", xLeft + xOffset, 					yTop + (aRow - 1) * yRow , 40, 14
	ui_infield "showShaftSize", xLeft + xOffset, 			yTop + (aRow - 1) * yRow + yLabel, 20, 24

	xOffset = xOffset + 40
	ui_outfield "Črta oboda:", xLeft + xOffset, 			yTop + (aRow - 1) * yRow , 100, 14
	ui_infield "lineShaftUnderground", xLeft + xOffset, 	yTop + (aRow - 1) * yRow + yLabel, 100, 24

	xOffset = xOffset + 100
	ui_outfield "Barva:", xLeft + xOffset, 					yTop + (aRow - 1) * yRow, 100, 14
	ui_infield "penShaftUnderground", xLeft + xOffset, 		yTop + (aRow - 1) * yRow + yLabel, 35, 24

	xOffset = xOffset + 50
	ui_outfield "Zadnji jašek:", xLeft + xOffset, 			yTop + (aRow - 1) * yRow , 80, 14
	ui_infield "showLastShaft", xLeft + xOffset, 			yTop + (aRow - 1) * yRow + yLabel, 20, 24

	aRow = aRow + 1

	xOffset = 0
	ui_outfield "Napis:", xLeft + xOffset, 					yTop + (aRow - 1) * yRow , 100, 14
	ui_infield "shaftCaptionLine1", xLeft + xOffset, 		yTop + (aRow - 1) * yRow + yLabel, 300, 20
	ui_infield "shaftCaptionLine2", xLeft + xOffset, 		yTop + (aRow - 1) * yRow + yLabel + 20, 300, 20
	ui_infield "shaftCaptionLine3", xLeft + xOffset, 		yTop + (aRow - 1) * yRow + yLabel + 40, 300, 20
	ui_infield "shaftCaptionLine4", xLeft + xOffset, 		yTop + (aRow - 1) * yRow + yLabel + 60, 300, 20

	xOffset = xOffset + 310
	ui_outfield "Prikaz:", xLeft + xOffset, 				yTop + (aRow - 1) * yRow , 100, 14
	ui_infield "showShaftCaption", xLeft + xOffset, 		yTop + (aRow - 1) * yRow + yLabel, 80, 22

	aRow = aRow + 2.4

	xOffset = 0
	ui_outfield "Iz MVO", xLeft + xOffset, 				yTop + (aRow - 1) * yRow , 60, 14
	ui_infield "shaftCaptionTextStyleByMVO", xLeft + xOffset, 		yTop + (aRow - 1) * yRow + yLabel, 20, 24

	xOffset = xOffset + 60
	ui_outfield "Pisava po meri:", xLeft + xOffset, 				yTop + (aRow - 1) * yRow , 100, 14
	ui_infield "shaftCaptionTextFont", xLeft + xOffset, 		yTop + (aRow - 1) * yRow + yLabel, 200, 24

	xOffset = xOffset + 210
	ui_outfield "Velikost [mm]:", xLeft + xOffset, 				yTop + (aRow - 1) * yRow , 100, 14
	ui_infield "shaftCaptionTextSize", xLeft + xOffset, 		yTop + (aRow - 1) * yRow + yLabel, 80, 24

	xOffset = xOffset + 90
	ui_outfield "Barva:", xLeft + xOffset, 					yTop + (aRow - 1) * yRow, 100, 14
	ui_infield "shaftCaptionTextPen", xLeft + xOffset, 		yTop + (aRow - 1) * yRow + yLabel, 35, 24

	xOffset = xOffset + 50
	ui_outfield "Slog:", xLeft + xOffset + 350, 			yTop + (aRow - 1) * yRow, 100, 14
	ui_textstyle_infield{2} "shaftCaptionTextStyle", 1+2+4,  xLeft + xOffset + 350, yTop + (aRow - 1) * yRow + yLabel, 24, 24 

return

! ------------------------------------------------------------------------------
"shaftDataPage":
	colW = 110
	xCol1 = 60
	xCol2 = xCol1 + colW + 10

	! --- izbira jaška ---
	aRow = 1
	xOffset = 0
	ui_outfield "ID jaška:", xLeft + xOffset, 				yTop + (aRow - 1) * yRow , 60, 14
	ui_infield "ui_shaft_index", xLeft + xOffset, 			yTop + (aRow - 1) * yRow + yLabel, 50, 22

	xOffset = xOffset + 70
	ui_outfield "Besedilo jaška:", xLeft + xOffset, 		yTop + (aRow - 1) * yRow , 150, 14
	ui_infield "ui_shaft_profile_text", xLeft + xOffset, 	yTop + (aRow - 1) * yRow + yLabel, 250, 22

	xOffset = xOffset + 260
	ui_outfield "Kaskada:", xLeft + xOffset, 				yTop + (aRow - 1) * yRow , 55, 14
	ui_infield "ui_shaft_cascade", xLeft + xOffset, 		yTop + (aRow - 1) * yRow + yLabel, 20, 22

	xOffset = xOffset + 60
	ui_outfield "Vrstice napisa 1-4:", xLeft + xOffset, 	yTop + (aRow - 1) * yRow , 110, 14
	ui_infield "ui_shaft_line1", xLeft + xOffset, 			yTop + (aRow - 1) * yRow + yLabel, 20, 22
	ui_infield "ui_shaft_line2", xLeft + xOffset + 20, 		yTop + (aRow - 1) * yRow + yLabel, 20, 22
	ui_infield "ui_shaft_line3", xLeft + xOffset + 40, 		yTop + (aRow - 1) * yRow + yLabel, 20, 22
	ui_infield "ui_shaft_line4", xLeft + xOffset + 60, 		yTop + (aRow - 1) * yRow + yLabel, 20, 22

	! --- dimenzije ---
	aRow = aRow + 1.3
	xOffset = 0
	ui_separator xLeft - 10, 								yTop + (aRow - 1) * yRow - 5, 		xLeft + 535, 	yTop + (aRow - 1) * yRow - 5
	ui_style 0, 1
	ui_outfield "Dimenzije", xLeft + xOffset, 				yTop + (aRow - 1) * yRow, 200, 14
	ui_style 0, 0

	aRow = aRow + 0.5
	xOffset = 0
	ui_outfield "Višina:", xLeft + xOffset, 				yTop + (aRow - 1) * yRow , 100, 14
	ui_infield "ui_shaft_height", xLeft + xOffset, 			yTop + (aRow - 1) * yRow + yLabel, 100, 22

	xOffset = xOffset + 110
	ui_outfield "Premer:", xLeft + xOffset, 				yTop + (aRow - 1) * yRow , 100, 14
	ui_infield "ui_shaft_dim1", xLeft + xOffset,			yTop + (aRow - 1) * yRow + yLabel, 100, 22

	xOffset = xOffset + 110
	ui_outfield "Povišek:", xLeft + xOffset, 				yTop + (aRow - 1) * yRow , 100, 14
	ui_infield "ui_shaft_raise", xLeft + xOffset,			yTop + (aRow - 1) * yRow + yLabel, 100, 22

	! --- kote ---
	aRow = aRow + 1.3
	ui_separator xLeft - 10, 								yTop + (aRow - 1) * yRow - 5, 		xLeft + 535, 	yTop + (aRow - 1) * yRow - 5
	ui_style 0, 1
	ui_outfield "Kote", xLeft, 								yTop + (aRow - 1) * yRow, 200, 14
	ui_style 0, 0

	aRow = aRow + 0.6
	ui_outfield "Od 0,00", xLeft + xCol1, 					yTop + (aRow - 1) * yRow , colW, 14
	ui_outfield "Absolutna (n.m.v.)", xLeft + xCol2, 		yTop + (aRow - 1) * yRow , colW, 14

	aRow = aRow + 0.4
	ui_outfield "Pokrov:", xLeft, 							yTop + (aRow - 1) * yRow + 4, 50, 14
	ui_infield "ui_shaft_cover_prj", xLeft + xCol1, 		yTop + (aRow - 1) * yRow, colW, 22
	ui_infield "ui_shaft_cover_abs", xLeft + xCol2, 		yTop + (aRow - 1) * yRow, colW, 22

	aRow = aRow + 0.6
	ui_outfield "Dno:", xLeft, 								yTop + (aRow - 1) * yRow + 4, 50, 14
	ui_infield "ui_shaft_bottom_prj", xLeft + xCol1, 		yTop + (aRow - 1) * yRow, colW, 22
	ui_infield "ui_shaft_bottom_abs", xLeft + xCol2, 		yTop + (aRow - 1) * yRow, colW, 22


	! --- dodatni vtoki/iztoki ---
	aRow = aRow + 1.3
	ui_separator xLeft - 10, 								yTop + (aRow - 1) * yRow - 5, 		xLeft + 535, 	yTop + (aRow - 1) * yRow - 5
	ui_style 0, 1
	ui_outfield "Dodatni vtoki/iztoki", xLeft, 				yTop + (aRow - 1) * yRow, 200, 14
	ui_style 0, 0

	aRow = aRow + 0.5
	xOffset = 0
	ui_outfield "Št.:", xLeft + xOffset, 					yTop + (aRow - 1) * yRow , 50, 14
	ui_infield "ui_port_index", xLeft + xOffset, 			yTop + (aRow - 1) * yRow + yLabel, 50, 22

	xOffset = xOffset + 60
	ui_outfield "Tip:", xLeft + xOffset, 					yTop + (aRow - 1) * yRow , 100, 14
	ui_infield "ui_port_type", xLeft + xOffset, 			yTop + (aRow - 1) * yRow + yLabel, 100, 22

	xOffset = xOffset + 110
	ui_outfield "Smer (azimut):", xLeft + xOffset, 			yTop + (aRow - 1) * yRow , 100, 14
	ui_infield "ui_port_angle", xLeft + xOffset, 			yTop + (aRow - 1) * yRow + yLabel, 100, 22

	xOffset = xOffset + 110
	ui_outfield "Višina od dna:", xLeft + xOffset, 			yTop + (aRow - 1) * yRow , 100, 14
	ui_infield "ui_port_height", xLeft + xOffset, 			yTop + (aRow - 1) * yRow + yLabel, 100, 22

	xOffset = xOffset + 110
	ui_outfield "Premer cevi:", xLeft + xOffset, 			yTop + (aRow - 1) * yRow , 100, 14
	ui_infield "ui_port_diameter", xLeft + xOffset, 		yTop + (aRow - 1) * yRow + yLabel, 100, 22
return

! ------------------------------------------------------------------------------
"pipePage":
	aRow = 1

	xOffset = 0
	ui_outfield "Črta:", xLeft + xOffset, 				yTop + (aRow - 1) * yRow , 100, 14
	ui_infield "linePipeAxis", xLeft + xOffset, 		yTop + (aRow - 1) * yRow + yLabel, 100, 24

	xOffset = xOffset + 100
	ui_outfield "Barva:", xLeft + xOffset, 				yTop + (aRow - 1) * yRow, 100, 14
	ui_infield "penPipeAxis", xLeft + xOffset , 		yTop + (aRow - 1) * yRow + yLabel, 35, 24

	xOffset = xOffset + 60
	ui_outfield "Debelina cevi:", xLeft + xOffset, 		yTop + (aRow - 1) * yRow , 100, 14
	ui_infield "showPipeOffsetLines", xLeft + xOffset, 	yTop + (aRow - 1) * yRow + yLabel, 20, 24

	xOffset = xOffset + 90
	ui_outfield "Črta:", xLeft + xOffset, 				yTop + (aRow - 1) * yRow , 100, 14
	ui_infield "linePipeOffset", xLeft + xOffset, 		yTop + (aRow - 1) * yRow + yLabel, 100, 24

	xOffset = xOffset + 100
	ui_outfield "Barva:", xLeft + xOffset, 				yTop + (aRow - 1) * yRow, 100, 14
	ui_infield "penPipeOffset", xLeft + xOffset , 		yTop + (aRow - 1) * yRow + yLabel, 35, 24

	aRow = aRow + 1

	xOffset = 0
	ui_outfield "Napis:", xLeft + xOffset, 				yTop + (aRow - 1) * yRow , 100, 14
	ui_infield "pipeCaption", xLeft + xOffset, 			yTop + (aRow - 1) * yRow + yLabel, 300, 24

	xOffset = xOffset + 310
	ui_outfield "Prikaz:", xLeft + xOffset, 			yTop + (aRow - 1) * yRow , 100, 14
	ui_infield "showPipeCaption", xLeft + xOffset, 		yTop + (aRow - 1) * yRow + yLabel, 80, 24

	aRow = aRow + 1

	xOffset = 0
	ui_outfield "Iz MVO", xLeft + xOffset, 				yTop + (aRow - 1) * yRow , 60, 14
	ui_infield "pipeCaptionTextStyleByMVO", xLeft + xOffset, 		yTop + (aRow - 1) * yRow + yLabel, 20, 24

	xOffset = xOffset + 50
	ui_outfield "Pisava:", xLeft + xOffset, 			yTop + (aRow - 1) * yRow , 100, 14
	ui_infield "pipeCaptionTextFont", xLeft + xOffset, 	yTop + (aRow - 1) * yRow + yLabel, 200, 24

	xOffset = xOffset + 210
	ui_outfield "Velikost [mm]:", xLeft + xOffset, 			yTop + (aRow - 1) * yRow , 100, 14
	ui_infield "pipeCaptionTextSize", xLeft + xOffset, 	yTop + (aRow - 1) * yRow + yLabel, 80, 24

	xOffset = xOffset + 90
	ui_outfield "Barva:", xLeft + xOffset, 				yTop + (aRow - 1) * yRow, 100, 14
	ui_infield "pipeCaptionTextPen", xLeft + xOffset, 	yTop + (aRow - 1) * yRow + yLabel, 35, 24

	xOffset = xOffset + 50
	ui_outfield "Slog:", xLeft + xOffset + 350, 		yTop + (aRow - 1) * yRow, 100, 14
	ui_textstyle_infield{2} "pipeCaptionTextStyle", 1+2+4,  xLeft + xOffset + 350, yTop + (aRow - 1) * yRow + yLabel, 24, 24 

	aRow = 4

	xOffset = 0
	ui_separator xLeft + xOffset - 10, 				yTop + (aRow - 1) * yRow + 25, 		xLeft + xOffset - 2,	 	yTop + (aRow - 1) * yRow + 25
	ui_outfield "Cev:", xLeft + xOffset, 			yTop + (aRow - 1) * yRow , 100, 14
	ui_infield "ui_pipe_index", xLeft + xOffset, 	yTop + (aRow - 1) * yRow + yLabel, 50, 22
	ui_separator xLeft + xOffset + 60, 				yTop + (aRow - 1) * yRow + 25, 		xLeft + xOffset + 300, 		yTop + (aRow - 1) * yRow + 25

	aRow = aRow + 1
	xOffset = 0
	ui_outfield "Premer Cevi:", xLeft + xOffset, yTop + (aRow - 1) * yRow , 200, 14
	ui_infield "ui_pipe_diameter", xLeft + xOffset, yTop + (aRow - 1) * yRow + yLabel, 200, 22

	aRow = aRow + 1.3
	xOffset = 0
	ui_separator xLeft + xOffset - 10, 				yTop + (aRow - 1) * yRow, 			xLeft + xOffset + 300,	 	yTop + (aRow - 1) * yRow
	ui_separator xLeft + xOffset - 10, 				yTop + (aRow - 2.7) * yRow, 		xLeft + xOffset - 10,	 	yTop + (aRow - 1) * yRow
	ui_separator xLeft + xOffset + 300, 			yTop + (aRow - 2.7) * yRow, 		xLeft + xOffset + 300,	 	yTop + (aRow - 1) * yRow
return

