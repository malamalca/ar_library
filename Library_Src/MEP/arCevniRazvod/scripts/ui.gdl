ui_dialog "ARHIM Cevni razvod"UI_CURRENT_PAGE gs_ui_current_pagexLeft = 20yTop = 5yLabel = 14yRow = 40iPageIDRoot			= -1iPageIDBasics		=  1iPageIDNodes		=  2iPageID2DRepr		=  3iPageIDText			=  4! ==============================================================================! UI_PAGES! ==============================================================================	UI_PAGE iPageIDBasics, iPageIDRoot, 'Osnovne nastavitve'		gosub "basicsPage"	UI_PAGE iPageIDNodes, iPageIDRoot, 'Vozlišča in odseki'		gosub "nodesPage"	UI_PAGE iPageID2DRepr, iPageIDRoot, '2D prikaz'		gosub "2DRepr"	UI_PAGE iPageIDText, iPageIDRoot, 'Napis in kote'		gosub "textPage"END! ==============================================================================! SUBROUTINES! ==============================================================================! ------------------------------------------------------------------------------! section header with a separator line above; sY = y offset, sTitle = caption"sectionTitle":	ui_separator xLeft - 10, yTop + sY, xLeft + 440, yTop + sY	ui_style 0, 1	ui_outfield sTitle, xLeft, yTop + sY + 4, 300, 14	ui_style 0, 0return! ------------------------------------------------------------------------------"basicsPage":	aRow = 1	xOffset = 0	ui_outfield "Vrsta voda:", xLeft + xOffset, 				yTop + (aRow - 1) * yRow , 200, 14	ui_infield "mepKind", xLeft + xOffset, 						yTop + (aRow - 1) * yRow + yLabel, 200, 24	xOffset = xOffset + 220	ui_infield "lockAngles", xLeft + xOffset, 					yTop + (aRow - 1) * yRow + yLabel + 2, 20, 20	ui_outfield "Zakleni kote na korake", xLeft + xOffset + 22, yTop + (aRow - 1) * yRow + yLabel + 5, 180, 14	aRow = aRow + 1.2	xOffset = 0	ui_outfield "Premer cevi [A]:", xLeft + xOffset, 			yTop + (aRow - 1) * yRow , 100, 14	ui_infield "A", xLeft + xOffset, 							yTop + (aRow - 1) * yRow + yLabel, 100, 24	xOffset = xOffset + 110	ui_outfield "Debelina stene:", xLeft + xOffset, 			yTop + (aRow - 1) * yRow , 100, 14	ui_infield "wallThickness", xLeft + xOffset, 				yTop + (aRow - 1) * yRow + yLabel, 100, 24	xOffset = xOffset + 110	ui_outfield "Padec [%]:", xLeft + xOffset, 					yTop + (aRow - 1) * yRow , 100, 14	ui_infield "slope", xLeft + xOffset, 						yTop + (aRow - 1) * yRow + yLabel, 100, 24	aRow = aRow + 1	xOffset = 0	ui_outfield "Dolžina:", xLeft + xOffset, 					yTop + (aRow - 1) * yRow , 100, 14	ui_infield "totalLength", xLeft + xOffset, 					yTop + (aRow - 1) * yRow + yLabel, 100, 24	xOffset = xOffset + 110	ui_outfield "Dolžina 3D:", xLeft + xOffset, 				yTop + (aRow - 1) * yRow , 100, 14	ui_infield "totalLength3D", xLeft + xOffset, 				yTop + (aRow - 1) * yRow + yLabel, 100, 24	xOffset = xOffset + 110	ui_outfield "Višinski odmik:", xLeft + xOffset, 			yTop + (aRow - 1) * yRow , 100, 14	ui_infield "costumOffset", xLeft + xOffset, 				yTop + (aRow - 1) * yRow + yLabel, 100, 24	aRow = aRow + 1.2	xOffset = 0	sY = (aRow - 1) * yRow - 8: sTitle = "3D prikaz": gosub "sectionTitle"	aRow = aRow + 0.4	ui_outfield "Material cevi:", xLeft + xOffset, 				yTop + (aRow - 1) * yRow , 200, 14	ui_infield "mat", xLeft + xOffset, 							yTop + (aRow - 1) * yRow + yLabel, 200, 24return! ------------------------------------------------------------------------------! node i = start of segment i; the last node (nSegments + 1) is the end of the pipe"nodesPage":	nNodes = nSegments + 1	aRow = 1	xOffset = 0	ui_outfield "Vozlišče:", xLeft + xOffset, 					yTop, 60, 14	ui_infield "ui_node_index", xLeft + xOffset, 				yTop + yLabel, 60, 24	ui_outfield "od " + STR(nNodes, 1, 0), xLeft + xOffset + 66, yTop + yLabel + 5, 50, 14	ui_button UI_FUNCTION, "Dodaj vozlišče", xLeft + 130, 		yTop + yLabel, 130, 24, 1	IF nSegments > 1 THEN		ui_button UI_FUNCTION, "Izbriši vozlišče", xLeft + 270,	yTop + yLabel, 130, 24, 2	ENDIF	! --- segment after the node -------------------------------------------------	IF ui_node_index <= nSegments THEN		sY = 52: sTitle = "Odsek za vozliščem": gosub "sectionTitle"		ui_outfield "Dolžina odseka:", xLeft, 					yTop + 74, 120, 14		ui_infield "ui_node_segment_length", xLeft, 			yTop + 74 + yLabel, 120, 24		ui_outfield "Kot loma:", xLeft + 130, 					yTop + 74, 120, 14		ui_infield "ui_node_direction", xLeft + 130, 			yTop + 74 + yLabel, 120, 24	ELSE		sY = 52: sTitle = "Konec cevi": gosub "sectionTitle"		ui_infield "endingCircle", xLeft, 						yTop + 74 + 2, 20, 20		ui_outfield "Krog na koncu", xLeft + 24, 				yTop + 74 + 5, 150, 14		ui_outfield "Zamik odmične črte:", xLeft, 				yTop + 74 + 30, 150, 14		ui_infield "lastOffsetDelta", xLeft, 					yTop + 74 + 30 + yLabel, 120, 24	ENDIF	! --- junction on the node -------------------------------------------------	IF (ui_node_index >= 2) AND (ui_node_index <= nSegments) THEN		sY = 140: sTitle = "Odcep": gosub "sectionTitle"		ui_outfield "Kot odcepa:", xLeft, 						yTop + 162, 120, 14		ui_infield "ui_node_junction", xLeft, 					yTop + 162 + yLabel, 120, 24		ui_outfield "Dolžina odcepa:", xLeft + 130, 			yTop + 162, 120, 14		ui_infield "ui_node_junction_length", xLeft + 130, 		yTop + 162 + yLabel, 120, 24		ui_outfield "Širina odcepa:", xLeft + 260, 				yTop + 162, 120, 14		ui_infield "ui_node_junction_width", xLeft + 260, 		yTop + 162 + yLabel, 120, 24		ui_outfield "Kot 0° pomeni navpični odcep. Odcep je mogoč samo, če je kot loma 0°.", xLeft, yTop + 162 + yLabel + 30, 420, 14	ENDIF	! --- start of the pipe ------------------------------------------------------	IF ui_node_index = 1 THEN		sY = 140: sTitle = "Začetek cevi": gosub "sectionTitle"		ui_infield "startingCircle", xLeft, 					yTop + 162 + 2, 20, 20		ui_outfield "Krog in navpični del na začetku", xLeft + 24, yTop + 162 + 5, 220, 14		ui_outfield "Višina navpičnega dela:", xLeft, 			yTop + 162 + 30, 150, 14		ui_infield "vertHeight", xLeft, 						yTop + 162 + 30 + yLabel, 120, 24		ui_outfield "Zamik odmične črte:", xLeft + 130, 		yTop + 162 + 30, 150, 14		ui_infield "firstOffsetDelta", xLeft + 130, 			yTop + 162 + 30 + yLabel, 120, 24	ENDIFreturn! ------------------------------------------------------------------------------"2DRepr":	aRow = 1	xOffset = 0	ui_outfield "Črta osi:", xLeft + xOffset, 					yTop + (aRow - 1) * yRow , 100, 14	ui_infield "ltAxis", xLeft + xOffset, 						yTop + (aRow - 1) * yRow + yLabel, 120, 24	xOffset = xOffset + 130	ui_outfield "Barva:", xLeft + xOffset, 						yTop + (aRow - 1) * yRow , 50, 14	ui_infield "penAxis", xLeft + xOffset, 						yTop + (aRow - 1) * yRow + yLabel, 40, 24	aRow = aRow + 1.2	xOffset = 0	sY = (aRow - 1) * yRow - 8: sTitle = "Odmične črte (debelina cevi)": gosub "sectionTitle"	aRow = aRow + 0.4	ui_outfield "Prikaži:", xLeft + xOffset, 					yTop + (aRow - 1) * yRow , 100, 14	ui_infield "offsetShow", xLeft + xOffset, 					yTop + (aRow - 1) * yRow + yLabel, 120, 24	xOffset = xOffset + 130	ui_outfield "Črta:", xLeft + xOffset, 						yTop + (aRow - 1) * yRow , 100, 14	ui_infield "ltOffset", xLeft + xOffset, 					yTop + (aRow - 1) * yRow + yLabel, 120, 24	xOffset = xOffset + 130	ui_outfield "Barva:", xLeft + xOffset, 						yTop + (aRow - 1) * yRow , 50, 14	ui_infield "penOffset", xLeft + xOffset, 					yTop + (aRow - 1) * yRow + yLabel, 40, 24	aRow = aRow + 1.2	xOffset = 0	sY = (aRow - 1) * yRow - 8: sTitle = "Krog na začetku in koncu": gosub "sectionTitle"	aRow = aRow + 0.4	ui_infield "startingCircle", xLeft + xOffset, 				yTop + (aRow - 1) * yRow + 2, 20, 20	ui_outfield "Krog na začetku", xLeft + xOffset + 24, 		yTop + (aRow - 1) * yRow + 5, 120, 14	xOffset = xOffset + 150	ui_infield "endingCircle", xLeft + xOffset, 				yTop + (aRow - 1) * yRow + 2, 20, 20	ui_outfield "Krog na koncu", xLeft + xOffset + 24, 			yTop + (aRow - 1) * yRow + 5, 120, 14	aRow = aRow + 0.8	xOffset = 0	ui_outfield "Črta kroga:", xLeft + xOffset, 				yTop + (aRow - 1) * yRow , 100, 14	ui_infield "ltCircle", xLeft + xOffset, 					yTop + (aRow - 1) * yRow + yLabel, 120, 24return! ------------------------------------------------------------------------------"textPage":	aRow = 1	xOffset = 0	ui_infield "textShow", xLeft + xOffset, 					yTop + (aRow - 1) * yRow + 2, 20, 20	ui_style 0, 1	ui_outfield "Prikaži napis", xLeft + xOffset + 24, 			yTop + (aRow - 1) * yRow + 5, 150, 14	ui_style 0, 0	aRow = aRow + 0.6	ui_outfield "Besedilo (spremenljivke: <length> <diameter> <slope>):", xLeft + xOffset, yTop + (aRow - 1) * yRow , 400, 14	ui_infield "textLine1", xLeft + xOffset, 					yTop + (aRow - 1) * yRow + yLabel, 300, 24	aRow = aRow + 1	ui_outfield "Pisava:", xLeft + xOffset, 					yTop + (aRow - 1) * yRow , 100, 14	ui_infield "textFont", xLeft + xOffset, 					yTop + (aRow - 1) * yRow + yLabel, 200, 24	xOffset = xOffset + 210	ui_outfield "Višina:", xLeft + xOffset, 				yTop + (aRow - 1) * yRow , 80, 14	ui_infield "textHeight", xLeft + xOffset, 					yTop + (aRow - 1) * yRow + yLabel, 80, 24	xOffset = xOffset + 90	ui_outfield "Barva:", xLeft + xOffset, 						yTop + (aRow - 1) * yRow , 50, 14	ui_infield "textPen", xLeft + xOffset, 						yTop + (aRow - 1) * yRow + yLabel, 40, 24	aRow = aRow + 1	xOffset = 0	ui_infield "textBold", xLeft + xOffset, 					yTop + (aRow - 1) * yRow + 2, 20, 20	ui_outfield "Krepko", xLeft + xOffset + 24, 				yTop + (aRow - 1) * yRow + 5, 70, 14	xOffset = xOffset + 100	ui_infield "textItalic", xLeft + xOffset, 					yTop + (aRow - 1) * yRow + 2, 20, 20	ui_outfield "Ležeče", xLeft + xOffset + 24, 				yTop + (aRow - 1) * yRow + 5, 70, 14	xOffset = xOffset + 100	ui_infield "textUnderline", xLeft + xOffset, 				yTop + (aRow - 1) * yRow + 2, 20, 20	ui_outfield "Podčrtano", xLeft + xOffset + 24, 				yTop + (aRow - 1) * yRow + 5, 90, 14	aRow = aRow + 0.8	xOffset = 0	ui_outfield "Položaj X:", xLeft + xOffset, 					yTop + (aRow - 1) * yRow , 80, 14	ui_infield "textPosX", xLeft + xOffset, 					yTop + (aRow - 1) * yRow + yLabel, 80, 24	xOffset = xOffset + 90	ui_outfield "Položaj Y:", xLeft + xOffset, 					yTop + (aRow - 1) * yRow , 80, 14	ui_infield "textPosY", xLeft + xOffset, 					yTop + (aRow - 1) * yRow + yLabel, 80, 24	xOffset = xOffset + 90	ui_outfield "Kot:", xLeft + xOffset, 						yTop + (aRow - 1) * yRow , 80, 14	ui_infield "textAngle", xLeft + xOffset, 					yTop + (aRow - 1) * yRow + yLabel, 80, 24	aRow = aRow + 1.2	xOffset = 0	sY = (aRow - 1) * yRow - 8: sTitle = "Kote": gosub "sectionTitle"	aRow = aRow + 0.4	ui_infield "elevationsShow", xLeft + xOffset, 				yTop + (aRow - 1) * yRow + 2, 20, 20	ui_outfield "Prikaži kote", xLeft + xOffset + 24, 			yTop + (aRow - 1) * yRow + 5, 100, 14	xOffset = xOffset + 150	ui_infield "textAbsolute", xLeft + xOffset, 				yTop + (aRow - 1) * yRow + 2, 20, 20	ui_outfield "Absolutne višine", xLeft + xOffset + 24, 		yTop + (aRow - 1) * yRow + 5, 120, 14	aRow = aRow + 0.8	xOffset = 0	ui_outfield "Višina besedila:", xLeft + xOffset, 		yTop + (aRow - 1) * yRow , 120, 14	ui_infield "elevationsTextHeight", xLeft + xOffset, 		yTop + (aRow - 1) * yRow + yLabel, 100, 24	xOffset = xOffset + 130	ui_outfield "Barva:", xLeft + xOffset, 						yTop + (aRow - 1) * yRow , 50, 14	ui_infield "penElevations", xLeft + xOffset, 				yTop + (aRow - 1) * yRow + yLabel, 40, 24return