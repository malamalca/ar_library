HIDEPARAMETER ALLDIM fontnames[]rrr = request ("FONTNAMES_LIST", "", fontNames)VALUES "textFont" fontNames, customDIM showOffsetLinesList[]showOffsetLinesList[showOffsetLinesNever] = "never"showOffsetLinesList[showOffsetLinesFromScale500] = "from 1:500"showOffsetLinesList[showOffsetLinesFromScale200] = "from 1:200"showOffsetLinesList[showOffsetLinesFromScale100] = "from 1:100"showOffsetLinesList[showOffsetLinesFromScale50] = "from 1:50"showOffsetLinesList[showOffsetLinesFromScale20] = "from 1:20"showOffsetLinesList[showOffsetLinesFromScale10] = "from 1:10"showOffsetLinesList[showOffsetLinesAlways] = "always"VALUES "offsetShow" showOffsetLinesListVALUES "mepKind" mepKindsIF GLOB_MODPAR_NAME = "offsetShow" THEN	FOR i = 1 TO 8		IF showOffsetLinesList[i] = offsetShow THEN			PARAMETERS iOffsetShow = i		ENDIF	NEXT iENDIFIF GLOB_MODPAR_NAME = "junctionHalfWidths" THEN	FOR i = 1 TO nSegments		junctionWidths[i] = junctionHalfWidths[i] * 2	NEXT iENDIF!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! node selection and editing (ui)! node i = start of segment i; node nSegments+1 = end of the pipeuiNode = ui_node_indexIF uiNode < 1 THEN uiNode = 1IF uiNode > nSegments + 1 THEN uiNode = nSegments + 1IF GLOB_UI_BUTTON_ID = 1 THEN GOSUB "insertNode"IF GLOB_UI_BUTTON_ID = 2 THEN GOSUB "deleteNode"IF (GLOB_MODPAR_NAME = "ui_node_segment_length") AND (uiNode <= nSegments) THEN	segments[uiNode] = ui_node_segment_length	IF segments[uiNode] < minSegmentLength THEN segments[uiNode] = minSegmentLengthENDIFIF (GLOB_MODPAR_NAME = "ui_node_direction") AND (uiNode <= nSegments) THEN	directions[uiNode] = ui_node_directionENDIFIF (uiNode >= 2) AND (uiNode <= nSegments) THEN	IF GLOB_MODPAR_NAME = "ui_node_junction" THEN junctions[uiNode] = ui_node_junction	IF GLOB_MODPAR_NAME = "ui_node_junction_length" THEN		junctionLengths[uiNode] = ui_node_junction_length		IF junctionLengths[uiNode] < minJunctionLength THEN junctionLengths[uiNode] = minJunctionLength	ENDIF	IF GLOB_MODPAR_NAME = "ui_node_junction_width" THEN		junctionWidths[uiNode] = ui_node_junction_width		IF junctionWidths[uiNode] < minJunctionWidth THEN junctionWidths[uiNode] = minJunctionWidth	ENDIFENDIF!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! minimum segment lengthIF (GLOB_MODPAR_NAME = "segments") OR (GLOB_MODPAR_NAME = "ui_node_segment_length") THEN	FOR i = 1 TO nSegments		! this is for relative positioning of straight sections		IF (ABS(segments[i]-tmpSegments[i]) > nix) AND (i < nSegments) AND (ABS(directions[i+1]) < nix) THEN			segments[i+1] = segments[i+1] + tmpSegments[i] - segments[i]			tmpSegments[i+1] = segments[i+1]		ENDIF		! this is min segment length		IF (segments[i] < minSegmentLength) AND ((ABS(directions[i+1]) > nix) OR (segments[i] > nix)) THEN			segments[i] = minSegmentLength		ENDIF	NEXT iENDIF!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! lock direction anglesIF (((GLOB_MODPAR_NAME = "directions") OR (GLOB_MODPAR_NAME = "ui_node_direction")) AND lockAngles) OR ((GLOB_MODPAR_NAME = "lockAngles") AND lockAngles) THEN	FOR i = 1 TO nSegments		direction = directions[i]		directionAdd = 0		directionSign = 1		IF direction > 180 THEN 			direction = 360 - direction			directionSign = -1			directionAdd = 360		ENDIF				IF direction <= 7.5 THEN			directions[i] = 0		ENDIF		IF direction > 7.5 AND direction <= 22.5 THEN			directions[i] = directionSign * 15 + directionAdd 		ENDIF		IF direction > 22.5 AND direction <= 37.5 THEN			directions[i] = directionSign * 30 + directionAdd 		ENDIF		IF direction > 37.5 AND direction <= 56.5 THEN			directions[i] = directionSign * 45 + directionAdd		ENDIF		IF direction > 56.5 AND direction <= 77.5 THEN			directions[i] = directionSign * 67.5 + directionAdd		ENDIF		IF direction > 77.5 THEN			!directions[i] = directionSign * 87.5 + directionAdd			directions[i] = directionSign * 90 + directionAdd		ENDIF	NEXT i	!PARAMETERS directions = directionsENDIF!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! lock direction anglesIF (((GLOB_MODPAR_NAME = "junctions") OR (GLOB_MODPAR_NAME = "ui_node_junction")) AND lockAngles) OR ((GLOB_MODPAR_NAME = "lockAngles") AND lockAngles) THEN	FOR i = 1 TO nSegments		junction = junctions[i]		junctionAdd = 0		junctionSign = 1		IF junction > 180 THEN 			junction = 360 - junction			junctionSign = -1			junctionAdd = 360		ENDIF				IF junction <= 15 THEN			junctions[i] = 0		ENDIF		IF junction > 15 AND junction <= 37.5 THEN			junctions[i] = junctionSign * 30 + junctionAdd 		ENDIF		IF junction > 37.5 AND junction <= 56.5 THEN			junctions[i] = junctionSign * 45 + junctionAdd		ENDIF		IF junction > 56.5 AND junction <= 77.5 THEN			junctions[i] = junctionSign * 67.5 + junctionAdd		ENDIF		IF junction > 77.5 AND junction <= 102.5 THEN			!junctions[i] = junctionSign * 87.5 + junctionAdd			junctions[i] = junctionSign * 90 + junctionAdd		ENDIF		IF junction > 102.5 AND junction <= 124 THEN			junctions[i] = junctionSign * 112.5 + junctionAdd		ENDIF		IF junction > 124 AND junction <= 147.5 THEN			junctions[i] = junctionSign * 135 + junctionAdd		ENDIF		IF junction > 147.5 THEN			junctions[i] = junctionSign * 150 + junctionAdd		ENDIF	NEXT iENDIF!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! total lengthtotalLength = 0FOR i = 1 TO nSegments	totalLength = totalLength + segments[i]NEXT iLOCK "totalLength", "totalLength3D"!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! node ui valuesIF uiNode > nSegments + 1 THEN uiNode = nSegments + 1IF uiNode < 1 THEN uiNode = 1DIM uiNodeRange[]FOR i = 1 TO nSegments + 1	uiNodeRange[i] = iNEXT iVALUES "ui_node_index" uiNodeRangeuiSegmentLength = 0uiDirection = 0uiJunction = 0uiJunctionLength = minJunctionLengthuiJunctionWidth = minJunctionWidthjunctionEditable = 0IF uiNode <= nSegments THEN	uiSegmentLength = segments[uiNode]	uiDirection = directions[uiNode]ENDIFIF (uiNode >= 2) AND (uiNode <= nSegments) THEN	uiJunction = junctions[uiNode]	IF junctionLengths[uiNode] > minJunctionLength THEN uiJunctionLength = junctionLengths[uiNode]	IF junctionWidths[uiNode] > minJunctionWidth THEN uiJunctionWidth = junctionWidths[uiNode]	IF ABS(directions[uiNode]) < nix THEN junctionEditable = 1ENDIFIF uiNode > nSegments THEN LOCK "ui_node_segment_length", "ui_node_direction"IF NOT(junctionEditable) THEN LOCK "ui_node_junction", "ui_node_junction_length", "ui_node_junction_width"PARAMETERS ui_node_index = uiNodePARAMETERS ui_node_segment_length = uiSegmentLengthPARAMETERS ui_node_direction = uiDirectionPARAMETERS ui_node_junction = uiJunctionPARAMETERS ui_node_junction_length = uiJunctionLengthPARAMETERS ui_node_junction_width = uiJunctionWidthPARAMETERS tmpInsSegments = insSegmentsPARAMETERS nSegments = nSegmentsPARAMETERS segments = segmentsPARAMETERS tmpSegments = segmentsPARAMETERS directions = directionsPARAMETERS junctions= junctionsPARAMETERS junctionWidths = junctionWidths PARAMETERS junctionLengths = junctionLengthsPARAMETERS totalLength = totalLengthPARAMETERS totalLength3D = totalLength / COS(0.45*slope)EXIT!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! insert node (button 1)! splits the segment after the selected node in half; on the last node the pipe is extended.! The new node is a vertical connection, same as the insert-segment hotspot."insertNode":	IF nSegments < 49 THEN		insPos = 0		IF uiNode <= nSegments THEN			IF segments[uiNode] >= 2 * minSegmentLength THEN				insPos = uiNode				insSegmentLength = segments[uiNode] / 2			ENDIF		ELSE			insPos = nSegments + 1			insSegmentLength = segments[nSegments]			IF insSegmentLength < minSegmentLength THEN insSegmentLength = minSegmentLength		ENDIF		IF insPos > 0 THEN			IF insPos <= nSegments THEN				FOR i = nSegments TO insPos STEP -1					IF i = insPos THEN						segments[i+1] = segments[i] - insSegmentLength					ELSE						segments[i+1] = segments[i]					ENDIF					directions[i+1] = directions[i]					junctions[i+1] = junctions[i]					junctionWidths[i+1] = junctionWidths[i]					junctionLengths[i+1] = junctionLengths[i]				NEXT i			ENDIF			segments[insPos] = insSegmentLength			directions[insPos+1] = 0			junctions[insPos+1] = 0			junctionWidths[insPos+1] = minJunctionWidth			junctionLengths[insPos+1] = minJunctionLength			nSegments = nSegments + 1			uiNode = insPos + 1		ENDIF	ENDIFRETURN!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! delete node (button 2)! the segment after the node is merged into the one before it; the turn at the node is! moved to the next node, so the rest of the pipe keeps its orientation."deleteNode":	IF nSegments > 1 THEN		IF uiNode <= nSegments THEN			delPos = uiNode			IF delPos > 1 THEN segments[delPos-1] = segments[delPos-1] + segments[delPos]			IF delPos < nSegments THEN				directions[delPos+1] = directions[delPos+1] + directions[delPos]				IF directions[delPos+1] >= 360 THEN directions[delPos+1] = directions[delPos+1] - 360			ENDIF			FOR i = delPos TO nSegments - 1				segments[i] = segments[i+1]				directions[i] = directions[i+1]				junctions[i] = junctions[i+1]				junctionWidths[i] = junctionWidths[i+1]				junctionLengths[i] = junctionLengths[i+1]			NEXT i		ENDIF		segments[nSegments] = 0		directions[nSegments] = 0		junctions[nSegments] = 0		junctionWidths[nSegments] = 0		junctionLengths[nSegments] = 0		nSegments = nSegments - 1		IF uiNode > nSegments + 1 THEN uiNode = nSegments + 1	ENDIFRETURN